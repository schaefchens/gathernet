{
  "name": "gathernet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@biomejs/biome"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "wasm:build": "wasm-pack build crates/mls-wasm --target web --release --out-dir ../../packages/mls-client/wasm --out-name mls_wasm",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.1",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
