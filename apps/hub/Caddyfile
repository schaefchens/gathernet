{
	auto_https off
}

:8080 {
	encode zstd gzip

	@api path /api/* /healthz
	handle @api {
		reverse_proxy {$API_UPSTREAM:server:4000}
	}

	@ws path /ws
	handle @ws {
		reverse_proxy {$API_UPSTREAM:server:4000}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Permissions-Policy "geolocation=(), microphone=()"
		}
		# Advertise the Tor onion service so Tor Browser offers the ".onion available"
		# button. Only emitted when ONION_HOST is set (the address the `tor` container
		# generates) — the expression is evaluated with the env value substituted at load,
		# so deployments without an onion send no header. Tor Browser only honours this
		# over HTTPS clearnet (TLS is terminated by the fronting proxy).
		@onion expression `"{$ONION_HOST:}" != ""`
		header @onion Onion-Location "http://{$ONION_HOST:}{uri}"
	}
}
